# Resend API Key (obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Destination email where new research inquiries will be delivered
INQUIRY_RECEIVER_EMAIL=your-recipient-email@example.com

# Sender address (optional).
# If unconfigured or set to a public webmail domain (gmail.com, yahoo.com, etc.),
# the backend automatically falls back to: "Brain & Pen Inquiries <onboarding@resend.dev>"
# Once you verify your domain in Resend (https://resend.com/domains), configure your custom address:
# RESEND_FROM_EMAIL=Brain & Pen Inquiries <inquiries@yourdomain.com>
RESEND_FROM_EMAIL=
