# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Destination email where new research inquiries will be delivered
INQUIRY_RECEIVER_EMAIL=your-email@example.com

# Sender address (optional). If unconfigured, defaults to "Brain & Pen Inquiries <onboarding@resend.dev>"
# Once you verify your domain in Resend, you can use: "Brain & Pen Inquiries <inquiries@yourdomain.com>"
RESEND_FROM_EMAIL=
