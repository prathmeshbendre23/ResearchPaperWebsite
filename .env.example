# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY= 

# Destination email where new research inquiries will be delivered
INQUIRY_RECEIVER_EMAIL=

# Sender address (optional). If unconfigured, defaults to "Academic Inquiries <onboarding@resend.dev>"
# Once you verify your domain in Resend, you can use: "Academic Inquiries <inquiries@yourdomain.com>"
RESEND_FROM_EMAIL=
